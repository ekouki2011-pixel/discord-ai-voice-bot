# コピー先は .env。値はチャット・GitHubへ貼らず、ホストのシークレット設定へ。
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 最初は検証用サーバーIDを指定。空欄だとグローバルコマンドを登録。
DISCORD_GUILD_ID=
# PortalのMessage Content Intentを正規に有効化してからtrueにする。
MESSAGE_CONTENT_ENABLED=false

DATABASE_PATH=data/bot.sqlite
TEMP_DIR=tmp
FFMPEG_PATH=ffmpeg
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
LOG_LEVEL=info

VOICEVOX_URL=http://127.0.0.1:50021
SAYDI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free

# 年齢・プラン・利用条件の確認を終えたエンジンだけカンマ区切りで設定。
# 例: voicevox,saydi（自動契約・自動承諾は行いません）
# ElevenLabsは18歳以上。SaydiVoiceは16歳未満に保護者の同意・監督が必要。
# Fish Audioは18歳未満に保護者の許可が必要。
ENGINE_TERMS_ACCEPTED=
GLOBAL_DAILY_CLOUD_CHARS=20000
MAX_SYNTH_CONCURRENCY=2
API_TIMEOUT_MS=180000
MAX_AUDIO_BYTES=20000000

# 使用許可のあるref.wavのセリフを正確に設定すると /wav が有効になります。
GPT_SOVITS_PROMPT_TEXT=
GPT_SOVITS_URL=https://folding-naples-carry-reforms.trycloudflare.com
